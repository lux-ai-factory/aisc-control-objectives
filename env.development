# Environment for running the wizard inside the aisc platform (compose merge).
# Hosts are compose SERVICE NAMES on the shared `backend` network. For standalone
# dev, set these in your shell or a local .env instead (see .env.example).

# Served behind Caddy under /wizard. FastAPI's root_path makes the service's
# /api/* routes resolve at /wizard/api/* so they don't collide with the aisc
# backend's own /api/*.
WIZARD_ROOT_PATH=/wizard
WIZARD_PORT=8090

# Catalogue backend the wizard reads tools/checklists from (read-only, SPEC §0).
# NOTE: the catalogue is currently a SEPARATE compose project, not an aisc
# submodule. Point this at wherever its backend is reachable on the network
# (a compose service name once both run on the same `backend` network).
WIZARD_CATALOGUE_URL=http://catalogue-backend:8000

# The model is chosen in wizard.toml; LiteLLM reads the provider key matching
# that model from the environment. Inject the real key via the platform env —
# do NOT commit secrets here.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
