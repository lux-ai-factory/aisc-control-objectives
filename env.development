# Environment for running the wizard inside the aisc platform (compose merge).
# Hosts are compose SERVICE NAMES on the shared `backend` network. For
# standalone dev, set these in your shell or a local .env (see .env.example).

# Served behind Caddy under /wizard. FastAPI's root_path makes the service's
# /api/* routes resolve at /wizard/api/* so they don't collide with the aisc
# backend's own /api/*.
WIZARD_ROOT_PATH=/wizard
WIZARD_PORT=8090

# The model, named BAF's way — the same two variables the qualification
# filler reads, so both services are configured alike.
BAF_LLM_PROVIDER=ollama
BAF_LLM_MODEL=mistral:latest
# A container reaching a model on the host, not in the compose network:
BAF_LLM_BASE_URL=http://host.docker.internal:11434

# For a hosted provider instead, inject the real key via the platform env —
# do NOT commit secrets here.
# BAF_LLM_PROVIDER=mistral
# BAF_LLM_MODEL=mistral-large-latest
# MISTRAL_API_KEY=

# Serve a different control-objectives export instead of the bundled CSV.
# WIZARD_OBJECTIVES_FILE=/path/to/ai_act_control_objectives.csv
