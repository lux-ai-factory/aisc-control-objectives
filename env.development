# Environment for running the service inside the aisc platform (compose merge).
# Hosts are compose SERVICE NAMES on the shared `backend` network. For
# standalone dev, set these in your shell or a local .env (see .env.example).

# Served behind Caddy under /control-objectives, which strips the prefix; root_path
# makes the URLs the service generates carry it.
CONTROL_OBJECTIVES_ROOT_PATH=/control-objectives
CONTROL_OBJECTIVES_PORT=8090

# The model, named BAF's way: the same two variables the qualification
# filler reads, so both services are configured alike. Compose overrides these
# three from CONTROL_OBJECTIVES_LLM_*.
BAF_LLM_PROVIDER=ollama
BAF_LLM_MODEL=mistral:latest
# A container reaching a model on the host, not in the compose network:
BAF_LLM_BASE_URL=http://host.docker.internal:11434

# For a hosted provider instead, pass the key through the stack's env file;
# never commit a key here.
# BAF_LLM_PROVIDER=mistral
# BAF_LLM_MODEL=mistral-large-latest
# MISTRAL_API_KEY=

# Serve a different control-objectives export instead of the bundled CSV.
# CONTROL_OBJECTIVES_FILE=/path/to/ai_act_control_objectives.csv
