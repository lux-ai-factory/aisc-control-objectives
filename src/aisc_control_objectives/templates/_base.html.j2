{%- from "_nav.html.j2" import site_links -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}AI Act Control Objectives{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=MuseoModerno:wght@500;600;700&family=Raleway:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  /* The AISC brand theme (shared/theme/brand.json), the same in every app so the
     modules look like one platform. */
  *, *::before, *::after { box-sizing: border-box; }
  :root {
    --bg: #f2f3fd;
    --panel: #ffffff;
    --panel-2: #f2f3fd;
    --text: #0b0b2e;
    --muted: #4a4f6a;
    --faint: #6b7090;
    --primary: #000fdf;
    --primary-hover: #000079;
    --accent: #ff007e;
    --accent-hover: #cc0066;
    --info: #0099ff;
    --info-soft: #ccebff;
    --pink-soft: #ffcce5;
    --border: #cccff9;
    --border-strong: #999ff2;
    --error: #e30613;
    --heading: #000079;
    --radius: 0px;
    font-family: "Raleway", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  html, body {
    margin: 0; padding: 0;
    background: var(--bg); color: var(--text);
    min-height: 100vh; font-size: 17px; line-height: 1.55;
  }
  h1, h2, h3, h4 { font-family: "MuseoModerno", ui-sans-serif, system-ui, sans-serif; font-weight: 700;
                   letter-spacing: -0.005em; color: var(--heading); }
  a { color: var(--primary); text-decoration: none; }
  a:hover { color: var(--accent); }

  /* Site header, as the qualification app's SiteHeader.tsx */
  .site-header {
    background: var(--panel); border-bottom: 1px solid var(--border);
    box-shadow: 0 1px 2px rgba(0, 15, 223, 0.05);
    position: sticky; top: 0; z-index: 50;
  }
  .site-header .inner {
    width: 100%; margin: 0; padding: 20px 40px;
    display: flex; align-items: center; justify-content: space-between; gap: 28px;
  }
  .site-header .brand {
    display: flex; align-items: center; gap: 18px;
    font-family: "MuseoModerno", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700; color: var(--text); font-size: 19px;
  }
  .site-header .brand img { height: 48px; width: auto; display: block; }
  .site-header .brand .divider { width: 1px; height: 30px; background: var(--border-strong); }
  .site-nav { display: flex; gap: 26px; font-size: 14px; font-weight: 700; }
  .site-nav a { color: var(--muted); padding: 4px 0; border-bottom: 2px solid transparent; }
  .site-nav a:hover { color: var(--primary); }
  .site-nav a.nav-here { color: var(--text); border-bottom-color: var(--accent); }

  /* Page frame */
  .co-page { max-width: 1320px; margin: 0 auto; padding: 48px 24px 96px; }
  .co-header h1 { margin: 0 0 8px; font-size: 30px; }
  .co-header p { color: var(--muted); margin: 0 0 24px; line-height: 1.5; max-width: 70ch; }
  /* "← Back to the project", a button of its own at the right of the header. */
  .site-header .site-back { margin-left: auto; }
  .site-header .site-back + .site-nav { margin-left: 0; }

  /* The assessment page, laid out like the qualification's card: a menu on the
     left shows one part at a time (sidemenu.js), the site's links pinned to its
     bottom. It is fixed against the left edge, from under the header to the bottom
     of the window: scrolling never moves it, and the page content starts after it.
     Without the script every part shows, one under the other. */
  :root {
    --site-header-h: 89px;  /* 20px + 48px logo + 20px, and the 1px border */
    --side-menu-w: 236px;   /* the menu's column, which the page content starts after */
  }
  .co-page:has(.co-sidemenu) { padding-top: 24px; padding-left: 32px; margin-left: var(--side-menu-w); margin-right: auto; }
  .co-sidemenu {
    position: fixed; left: 0; top: var(--site-header-h); bottom: 0; width: var(--side-menu-w);
    box-sizing: border-box; overflow-y: auto; z-index: 10;
    display: flex; flex-direction: column; gap: 20px;
    padding: 24px 16px; background: var(--panel); border-right: 1px solid var(--border);
  }
  .co-sidemenu ul { list-style: none; margin: 0; padding: 0; }
  .co-sidemenu li a {
    display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
    padding: 7px 12px; border-left: 2px solid transparent;
    font-size: 14px; font-weight: 500; line-height: 1.35; color: var(--muted);
  }
  .co-sidemenu li a .n { flex-basis: 100%; font-size: 12px; color: var(--muted); }
  .co-sidemenu li a:hover { color: var(--text); background: var(--panel-2); }
  .co-sidemenu li a.active { color: var(--primary); border-left-color: var(--primary); background: var(--panel-2); }
  .co-sidemenu-site { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--border); }
  .co-sidemenu-nav { display: flex; flex-direction: column; gap: 2px; font-size: 13px; font-weight: 600; }
  .co-sidemenu-nav a { padding: 6px 12px; color: var(--muted); }
  .co-sidemenu-nav a:hover, .co-sidemenu-nav a.nav-here { color: var(--primary); }
  .co-part { scroll-margin-top: calc(var(--site-header-h) + 16px); }
  /* The header's own links give way to the copy at the bottom of the menu. */
  body:has(.co-sidemenu) .site-header .site-nav { display: none; }
  /* A narrow window has no room for a column: the menu goes above the content, as a block. */
  @media (max-width: 760px) {
    .co-page:has(.co-sidemenu) { margin-left: auto; padding-left: 24px; }
    .co-sidemenu {
      position: static; width: auto; padding: 0 0 14px; margin-bottom: 20px;
      background: none; border-right: none; border-bottom: 1px solid var(--border);
    }
  }

  .co-back { display: inline-block; font-size: 13px; font-weight: 700; margin-bottom: 18px; }

  .co-stats { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; }
  .co-stat {
    background: var(--panel-2); border: 1px solid var(--border); padding: 12px 16px; min-width: 132px;
  }
  .co-stat .v { font-size: 24px; font-weight: 900; letter-spacing: -0.01em; line-height: 1.1; }
  .co-stat .k {
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--muted); margin-top: 2px;
  }

  /* Cards (.qf-section) */
  .qf-section {
    background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 24px; margin-bottom: 20px; box-shadow: 0 1px 2px rgba(0, 15, 223, 0.03);
  }
  .qf-section h2 { margin: 0 0 6px; font-size: 18px; }
  .qf-help { color: var(--muted); font-size: 13px; margin: 0 0 18px; line-height: 1.5; }

  /* Forms (.field, .btn) */
  .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
  .field label {
    font-size: 12px; color: var(--muted); font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .field input, .field select {
    background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 11px 13px; color: var(--text); font-size: 14px; outline: none; font-family: inherit;
  }
  .field input:focus, .field select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(0, 15, 223, 0.1); }
  .field input::placeholder { color: var(--faint); opacity: 1; font-weight: 400; font-style: italic; }
  .btn {
    display: inline-block; background: var(--primary); color: #ffffff; border: 0;
    border-radius: var(--radius); padding: 12px 18px; font-size: 14px; font-weight: 800;
    letter-spacing: 0.01em; cursor: pointer; text-align: center; transition: background 0.15s ease;
    font-family: inherit;
  }
  .btn:hover { background: var(--accent); color: #ffffff; }
  .qf-actions { display: flex; justify-content: flex-end; margin-top: 8px; }
  .qf-actions .btn { width: auto; padding: 13px 26px; }
  .error {
    background: #fdecf2; border: 1px solid #f5b8cd; color: var(--accent);
    padding: 10px 12px; border-radius: var(--radius); font-size: 13px; margin-bottom: 14px; font-weight: 600;
  }
  .notice {
    background: var(--info-soft); border: 1px solid #99d6ff; color: #00337a;
    padding: 10px 12px; font-size: 13px; margin-bottom: 14px; font-weight: 600;
  }
  .co-count { font-size: 12px; font-weight: 700; color: var(--muted); margin-top: 12px; }

  /* Macro requirement heading inside its card */
  .co-macro-head {
    display: flex; align-items: baseline; gap: 12px;
    padding-bottom: 14px; margin-bottom: 4px; border-bottom: 1px solid var(--border);
  }
  .co-macro-head h2 { flex: 1; }
  .co-macro-id {
    background: var(--primary); color: #ffffff; font-size: 12px; font-weight: 600;
    letter-spacing: 0.04em; padding: 3px 8px; font-family: "IBM Plex Mono", ui-monospace, monospace;
  }
  .co-macro-head .n {
    font-size: 12px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.04em; color: var(--muted);
  }

  /* One objective */
  .co-obj { border-top: 1px solid var(--border); padding: 18px 0 16px; }
  .co-obj:first-of-type { border-top: 0; }
  .co-obj-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }
  .co-obj-id { font-size: 12px; font-weight: 600; color: var(--muted); letter-spacing: 0.04em;
              font-family: "IBM Plex Mono", ui-monospace, monospace; }
  .co-obj-head h3 { font-size: 15px; margin: 0; flex: 1; min-width: 220px; }
  .co-obj p.co-text { margin: 0 0 12px; font-size: 15px; line-height: 1.55; }
  .co-obj--out h3, .co-obj--out .co-text { color: var(--muted); }

  .qf-tag {
    display: inline-block; background: var(--panel-2); border: 1px solid var(--border);
    color: var(--muted); font-size: 11px; padding: 2px 6px; border-radius: 0;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .qf-tag--in { background: var(--info-soft); border-color: #99d6ff; color: #00337a; }
  .qf-tag--voluntary { background: var(--pink-soft); border-color: #f5b8cd; color: #8a1242; }
  .qf-tag--pending { background: #fff7d6; border-color: #f2df9a; color: #6b5300; }
  .qf-tag--tier1 { background: var(--primary); border-color: var(--primary); color: #ffffff; }
  .qf-tag--tier2 { background: var(--info-soft); border-color: #99d6ff; color: #00337a; }
  .qf-tag--tier3 { background: var(--panel-2); border-color: var(--border); color: var(--muted); }
  .co-tier--1 { border-left: 4px solid var(--primary); }
  .co-tier--2 { border-left: 4px solid var(--info-soft); }
  .co-tier--no .co-obj, .co-tier--undetermined .co-obj { opacity: 0.75; }
  /* Step 2: the risk register and the risk and control matrix */
  .co-register, .co-matrix { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .co-register th, .co-matrix th { text-align: left; font-size: 11px; font-weight: 700; letter-spacing: .06em;
    text-transform: uppercase; color: var(--muted); padding: 8px 10px; border-bottom: 2px solid var(--border); }
  .co-register th span, .co-matrix th span { text-transform: none; font-weight: 400; }
  .co-register td, .co-matrix td { padding: 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .co-register textarea { width: 100%; min-width: 180px; box-sizing: border-box; font: inherit; font-size: 13px; resize: vertical; }
  .co-reg-risk { width: 44%; }
  /* a risk's full information folds open under its row, across the whole table */
  .co-register tr:has(+ .co-reg-info) td { border-bottom: 0; padding-bottom: 2px; }
  .co-reg-info td { padding-top: 0; }
  .co-reg-info .qf-dl { margin: 8px 0 4px; }
  .co-chain summary { cursor: pointer; font-size: 12px; color: var(--primary); margin-top: 4px; }
  .co-rating { display: inline-block; min-width: 28px; padding: 3px 6px; border-radius: 4px; text-align: center;
               font-weight: 800; font-size: 13px; }
  .co-rating--low { background: #e8f5e9; color: #256b29; }
  .co-rating--medium { background: #fff7d6; color: #6b5300; }
  .co-rating--high { background: #ffe5cc; color: #8a3c00; }
  .co-rating--critical { background: #c62828; color: #ffffff; }
  .co-rating--not-rated { background: #eceff1; color: #546e7a; }
  .co-band { display: block; margin-top: 3px; font-size: 11px; color: var(--muted); }
  .co-m-risk { width: 26%; font-weight: 600; }
  /* The matrix's objective chips: blue is key, grey the rest; a yellow ring is an AI suggestion */
  .co-chips { line-height: 2.2; }
  .co-chip-wrap { display: inline-block; margin: 0 6px 4px 0; }
  .co-chip { display: inline-block; font: inherit; font-size: 12.5px; font-weight: 800; letter-spacing: .02em;
             padding: 3px 9px; border-radius: 999px; border: 2px solid transparent; cursor: pointer; line-height: 1.3; }
  .co-chip--key { background: var(--primary); color: #ffffff; }
  .co-chip--plain { background: var(--panel-2, #eef0f6); color: var(--text); }
  .co-chip--ai { border-color: #f2c200; }
  span.co-chip { cursor: default; }
  .co-legend { display: flex; flex-wrap: wrap; gap: 6px 22px; list-style: none; margin: 4px 0 14px; padding: 0;
               font-size: 12.5px; color: var(--muted); }
  .co-legend li { display: flex; align-items: center; gap: 8px; }
  .co-chip-pop, .co-edit-pop { max-width: 440px; padding: 16px 18px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--panel); color: var(--text); font-size: 13.5px; line-height: 1.5; box-shadow: 0 10px 30px rgba(20, 24, 60, .2); }
  .co-edit-pop { width: min(960px, 92vw); max-width: none; max-height: 80vh; overflow: auto; text-align: left; }
  .co-edit-pop form { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 4px 24px; }
  .co-edit-pop .co-pop-head, .co-edit-pop .qf-actions { grid-column: 1 / -1; }
  .co-chip-pop p { margin: 0 0 8px; }
  .co-pop-head { font-size: 14.5px; }
  .co-pop-text { color: var(--muted); }
  .co-pop-dl { display: grid; grid-template-columns: 60px 1fr; gap: 4px 10px; margin: 0 0 10px; font-size: 13px; }
  .co-pop-dl dt { color: var(--muted); font-weight: 700; }
  .co-pop-dl dd { margin: 0; }
  .co-pop-key { display: flex; align-items: center; gap: 8px; font-weight: 700; }
  .co-edit { font: inherit; font-size: 13px; color: var(--primary); background: none; border: 1px solid var(--border);
             border-radius: 6px; padding: 4px 12px; cursor: pointer; }
  .co-edit:hover { border-color: var(--primary); }
  .co-m-edit { width: 70px; text-align: right; }
  /* A dropdown in the page's own style: thin border, the folds' chevron, the value in bold */
  select.co-select { min-width: 64px; appearance: none; -webkit-appearance: none; font: inherit; font-size: 14px; font-weight: 700;
    color: var(--text); background-color: var(--panel); border: 1px solid var(--border); border-radius: 6px;
    padding: 6px 30px 6px 12px; cursor: pointer; line-height: 1.2;
    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%),
                      linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position: calc(100% - 15px) 52%, calc(100% - 10px) 52%;
    background-size: 5px 5px, 5px 5px; background-repeat: no-repeat; }
  select.co-select:hover { border-color: var(--border-strong, #a9b0c6); }
  select.co-select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(0, 15, 223, .12); }
  /* Objective sets and profiles */
  .co-code { display: inline-block; padding: 2px 8px; border-radius: 4px; background: var(--text); color: var(--panel);
             font-size: 12px; font-weight: 600; letter-spacing: .06em; font-family: "IBM Plex Mono", ui-monospace, monospace; }
  .co-code--big { font-size: 20px; padding: 2px 10px; vertical-align: middle; }
  .co-form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px 20px; }
  .co-form-grid .co-form-wide { grid-column: 1 / -1; }
  .co-form-grid label span { color: var(--muted); font-weight: 400; text-transform: none; }
  .co-form-grid input, .co-form-grid select, .co-form-grid textarea { width: 100%; box-sizing: border-box; font: inherit; }
  .co-set-actions { display: flex; gap: 10px; margin: 0 0 18px; }
  .co-set-actions form { margin: 0; }
  .co-obj-actions { display: flex; align-items: flex-start; gap: 16px; margin-top: 8px; }
  .co-obj-actions form { margin: 0; }
  .co-obj--retired { opacity: .55; }
  .co-versions { margin: 6px 0 0; padding-left: 18px; font-size: 13.5px; line-height: 1.8; }
  .co-update { margin: 0 0 18px; padding: 12px 16px; border: 1px solid #f2df9a; border-radius: var(--radius);
               background: #fff7d6; color: #6b5300; font-size: 13.5px; }
  .co-update p { margin: 0; }
  .btn--ghost { background: var(--panel); color: var(--primary); border: 1px solid var(--primary); }
  /* Step 2: the objective profile it runs on */
  .co-profile { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin: 0 0 20px;
                padding: 14px 18px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--panel); }
  .co-profile-k { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .co-profile-name { font-size: 15px; }
  .co-profile-update { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0; font-size: 13px; color: #6b5300; }
  .co-profile-update .qf-help { flex-basis: 100%; margin: 0; }
  .co-profile-note { font-size: 13px; color: var(--muted); }
  .co-profile-change { margin-left: auto; }
  .co-profile-change summary { cursor: pointer; font-size: 13px; color: var(--primary); }
  .co-profile-change form { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 8px; }
  .co-profile-change .qf-help { flex-basis: 100%; margin: 0; }
  .btn--small { padding: 6px 12px; font-size: 13px; }
  /* Step 2: every part folds; the head is the handle */
  details.co-fold > summary { cursor: pointer; list-style: none; }
  details.co-fold > summary::-webkit-details-marker { display: none; }
  details.co-fold > summary::after { content: ""; width: 8px; height: 8px; margin-left: 4px;
    border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted);
    transform: rotate(45deg); transition: transform .15s; }
  details.co-fold:not([open]) > summary::after { transform: rotate(-45deg); }
  details.co-fold:not([open]) > summary { margin-bottom: 0; padding-bottom: 0; border-bottom: 0; }
  details.co-fold:not([open]) > summary h2 { margin-bottom: 0; }
  details.co-fold > summary { align-items: center; }
  /* A comment on a severity */
  .co-sev-label { display: block; margin-top: 10px; font-size: 12px; }
  .co-sev-label span { color: var(--muted); font-weight: 400; }
  .field textarea { width: 100%; box-sizing: border-box; font: inherit; font-size: 13px; resize: vertical; }
  .co-sev-comment { margin: 4px 0 0; font-size: 13px; color: var(--muted); font-style: italic; }
  /* Suggest with AI, and its ? */
  .co-ai { display: flex; align-items: center; gap: 10px; margin: 6px 0 14px; }
  .co-ai-replace { font-size: 13px; color: var(--muted); }
  .co-confirm p { margin: 0 0 8px; }
  .co-carried summary { cursor: pointer; }
  .co-key-why { font-weight: 400; color: var(--muted); }
  .co-card-changed form { display: flex; align-items: center; gap: 10px; margin-top: 8px; }
  .co-card-changed .qf-help { margin: 0; font-weight: 400; }
  .co-carried p { margin: 8px 0 0; font-size: 13px; }
  /* the hashes and the AI run's ids, folded away at the bottom of the assessment */
  .co-tech { margin-top: 12px; font-size: 12px; font-weight: 700; color: var(--muted); }
  .co-tech summary { cursor: pointer; }
  .co-tech p { margin: 6px 0 0; }
  .co-confirm a { margin-left: 10px; font-size: 13px; }
  .co-help { width: 24px; height: 24px; border-radius: 50%; border: 1px solid var(--border);
             background: var(--panel); color: var(--primary); font-weight: 700; cursor: pointer; padding: 0; }
  .co-help:hover { border-color: var(--primary); }
  .co-help-pop { max-width: 420px; padding: 14px 16px; border: 1px solid var(--border); border-radius: 6px;
                 background: var(--panel); color: var(--text); font-size: 13px; line-height: 1.5;
                 box-shadow: 0 8px 24px rgba(20, 24, 60, .18); }
  /* Step 2: each risk's mapping, by the AI or the assessor */
  .co-map-edit summary { cursor: pointer; font-size: 13px; color: var(--primary); }
  .co-map-edit form { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
                     gap: 4px 28px; align-items: start; }
  .co-map-edit form .qf-actions { grid-column: 1 / -1; }
  .co-map-dim { border: 0; margin: 10px 0 0; padding: 0; min-width: 0; }
  .co-map-dim legend { margin-bottom: 4px; }
  .co-map-pick { display: block; font-size: 13px; padding: 2px 0; }
  .co-map-pick b { display: inline-block; min-width: 34px; }
  /* The trustworthiness dimension of an objective, in the tools catalogue's colours */
  .co-dim { display: inline-block; padding: 2px 8px; border-radius: 999px; border: 1px solid;
            font-size: 11px; font-weight: 600; letter-spacing: 0.02em; white-space: nowrap; }
  .co-dim--r1 { background: #fff3e0; border-color: #ffd8a8; color: #a33a00; }
  .co-dim--r2 { background: #e7f0ff; border-color: #bcd0fb; color: #2f4bb8; }
  .co-dim--r3 { background: #e8f5e9; border-color: #b9dfbd; color: #256b29; }
  .co-dim--r4 { background: #e0f7fa; border-color: #a8e3ea; color: #00695c; }
  .co-dim--r5 { background: #fce4ec; border-color: #f5b8cb; color: #b02424; }
  .co-dim--r6 { background: #f3e5f5; border-color: #ddbde3; color: #6a1b9a; }
  .co-dim--r7 { background: #fff8e1; border-color: #f2dc95; color: #7a4a00; }
  .co-dim--r8 { background: #e8eaf6; border-color: #c3c8ea; color: #283593; }
  .co-dim--r9 { background: #efebe9; border-color: #d5cbc6; color: #4e342e; }
  .co-dim--r10 { background: #eceff1; border-color: #cbd3d8; color: #37474f; }
  .co-dim--r11 { background: #f4f4f4; border-color: #d6d6d6; color: #424242; }
  .co-stat--tier1 { background: var(--primary); border-color: var(--primary); }
  .co-stat--tier1 .v, .co-stat--tier1 .k { color: #ffffff; }
  .co-why { color: var(--text); font-weight: 500; }
  .co-why b { font-weight: 800; }

  /* One row per risk: the chain on the left, its severity on the right */
  .co-risk { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 24px;
             padding: 18px 0; border-top: 1px solid var(--border); }
  .co-risk:first-of-type { border-top: 0; padding-top: 4px; }
  .co-risk h3 { font-size: 16px; margin: 0 0 10px; }
  .co-risk .qf-dl { grid-template-columns: 130px 1fr; }
  .co-risk .field { margin-bottom: 0; }
  .co-risk .qf-tag { margin: 0 4px 4px 0; text-transform: none; letter-spacing: 0; font-weight: 600; }
  @media (max-width: 720px) { .co-risk { grid-template-columns: 1fr; } }

  .qf-dl {
    display: grid; grid-template-columns: 150px 1fr; gap: 6px 18px;
    margin: 0; font-size: 13px; line-height: 1.5;
  }
  .qf-dl dt {
    color: var(--muted); font-weight: 700; font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.04em; padding-top: 2px;
  }
  .qf-dl dd { margin: 0; }
  .qf-dl code {
    font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px; background: var(--panel-2); border: 1px solid var(--border); padding: 1px 5px;
  }

  .co-note {
    margin: 12px 0 0; padding: 10px 12px; font-size: 13px; line-height: 1.5;
    background: var(--panel-2); border: 1px solid var(--border); color: var(--muted); font-weight: 600;
  }
  .co-note--flag { background: #fdecf2; border-color: #f5b8cd; color: var(--accent); }
  .co-note b { font-weight: 800; }
  .co-reason { margin: 0 0 8px; font-size: 13px; color: var(--muted); font-weight: 600; }

  .qf-empty {
    display: none; text-align: center; padding: 48px 24px;
    background: var(--panel); border: 1px dashed var(--border);
  }
  .qf-empty p { color: var(--muted); margin: 0; }
  .is-hidden { display: none !important; }

  @media (max-width: 720px) {
    .site-header .inner { padding: 16px 20px; flex-wrap: wrap; gap: 12px; }
    .site-nav { gap: 18px; font-size: 13px; }
    .qf-dl { grid-template-columns: 1fr; gap: 2px; }
    .qf-dl dd { margin-bottom: 8px; }
  }
</style>
</head>
<body>

<header class="site-header">
  <div class="inner">
    {# Like the qualification app's: the mark goes back to the launcher,
       to this project's page when there is one. #}
    <a class="brand" href="{{ project_page or launcher_url() }}">
      <img src="{{ root_path }}/static/laif-logo.svg" alt="Luxembourg AI Factory">
      <span class="divider"></span>
      <span>AI Act Control Objectives</span>
    </a>
    {# Back to this project's page on the launcher, where the other five steps
       are: a button of its own, which stays when a page moves its links into
       its left menu. The project is chosen there, once. #}
    {% if project_page %}<a class="btn btn--ghost btn--small site-back" href="{{ project_page }}" >&larr; Back to the project</a>{% endif %}
    <nav class="site-nav">
{{ site_links(project_base, root_path, here) }}
    </nav>
  </div>
</header>

<div class="co-page">
{% block content %}{% endblock %}
</div>

{% block scripts %}{% endblock %}
</body>
</html>
