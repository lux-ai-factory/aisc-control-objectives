{% extends "_base.html.j2" %}

{% block title %}Assessments · AI Act Control Objectives{% endblock %}

{% block content %}
  <div class="co-header">
    <h1>Assessments</h1>
    <p>One assessment per saved version of the system's <strong>AI card</strong>. Start
       it from the latest version, rate the risks the card carries, and it works out
       which control objectives answer them and which to start with.</p>
  </div>

  <div class="qf-section">
    <h2>Assess the latest AI card</h2>
    <p class="qf-help">The assessment is of the project's latest saved AI card version, read
       from step 1, Qualify: what the system is and the risks its assessor identified. Starting
       again on the same version opens its assessment. A new version's assessment starts with the
       ratings, links and priority choices of the risks it shares with the previous version's.</p>
    {#- starting again on an assessed version would only open its assessment -#}
    {%- if latest %}
    <div class="qf-actions"><a class="btn" href="{{ project_base }}/projects/{{ latest.record.id }}">Open the assessment of v{{ latest.record.version_number }}</a></div>
    {%- else %}
    <form method="post" action="{{ project_base }}/projects">
      <div class="field">
        <label for="name">Assessment name <span style="text-transform:none">(optional, defaults to the system's name)</span></label>
        <input id="name" name="name" type="text" placeholder="MCAS v1.2.0 pre-market assessment">
      </div>
      <div class="qf-actions"><button class="btn" type="submit">Start assessment</button></div>
    </form>
    {%- endif %}
  </div>

  {%- if projects %}
  <div class="qf-section">
    <div class="co-macro-head">
      <h2>Under assessment</h2>
      <span class="n">{{ projects | length }}</span>
    </div>
    {%- for view in projects %}
    {%- set record = view.record %}
    <article class="co-obj">
      <div class="co-obj-head">
        <h3><a href="{{ project_base }}/projects/{{ record.id }}">{{ record.name }}</a></h3>
        {%- if not view.rated %}
        <span class="qf-tag qf-tag--pending">Awaiting your rating</span>
        {%- elif not view.mapped %}
        <span class="qf-tag qf-tag--in">Ready to link</span>
        {%- else %}
        {%- set n_keys = view.priorities | selectattr('key') | list | length %}
        <span class="qf-tag qf-tag--tier1">{{ n_keys }} priority {{ 'objective' if n_keys == 1 else 'objectives' }}</span>
        {%- endif %}
      </div>
      <p class="co-reason">
        {#- only the latest card version's assessment may still change -#}
        {% if record.version_number %}v{{ record.version_number }} · {% endif %}{{ "latest" if latest and latest.record.id == record.id else "read-only" }} ·
        {{ record.system_name or "unnamed system" }} ·
        {{ record.ontology.risks | length }} risk{{ 's' if record.ontology.risks | length != 1 }} ·
        updated {{ record.updated_at.strftime('%Y-%m-%d %H:%M') }}
      </p>
    </article>
    {%- endfor %}
  </div>
  {%- else %}
  <div class="qf-empty" style="display:block">
    <p>No systems under assessment yet.</p>
  </div>
  {%- endif %}
{% endblock %}
