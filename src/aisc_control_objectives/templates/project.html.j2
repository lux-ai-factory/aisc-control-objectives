{% extends "_base.html.j2" %}

{% block title %}{{ view.record.name }} · Control Objectives{% endblock %}

{% block content %}
  {%- set record = view.record %}
  <a class="co-back" href="{{ project_base }}/projects">← Projects</a>

  <div class="co-header">
    <h1>{{ record.name }}</h1>
    <p>{% if record.version_number %}Assessment of v{{ record.version_number }} · {% endif %}{{ record.system_name }}{% if record.qualification_id %} · qualification {{ record.qualification_id }}{% endif %}</p>
  </div>
  {%- if read_only %}
  <div class="error">{{ read_only }}. This assessment is kept as it was: open the latest version's assessment from the projects page to rank and map.</div>
  {%- endif %}

  {# ── the objective profile it runs on ──────────────────────────────────
     Everything below sees only this profile's objectives. #}
  <div class="co-profile">
    <span class="co-profile-k">Objective profile</span>
    <b class="co-profile-name">{{ profile['label'] }}</b>
    {%- if profile['update'] and not read_only %}
    <form method="post" action="{{ project_base }}/projects/{{ record.id }}/profile" class="co-profile-update">
      <input type="hidden" name="profile" value="{{ profile['id'] }}">
      <span>Version {{ profile['update']['to'] }} is out.</span>
      <button class="btn btn--small" type="submit">Take version {{ profile['update']['to'] }}</button>
    </form>
    {%- elif profile['update'] %}<span class="co-profile-note">Version {{ profile['update']['to'] }} is out.</span>
    {%- endif %}
    {%- if not read_only %}
    <details class="co-profile-change">
      <summary>Change profile</summary>
      <form method="post" action="{{ project_base }}/projects/{{ record.id }}/profile">
        <select name="profile" aria-label="Objective profile">
          {%- for p in profiles %}
          <option value="{{ p.id }}"{% if p.id == profile['id'] %} selected{% endif %}>{{ p.name }}{% if p.number %} (version {{ p.number }}){% endif %} · {{ p.objectives }} objectives</option>
          {%- endfor %}
        </select>
        <button class="btn btn--small" type="submit">Use this profile</button>
        <p class="qf-help">Mappings and selected objectives outside the new profile are dropped.
           Profiles are made on the <a href="{{ project_base }}/profiles">Profiles</a> page.</p>
      </form>
    </details>
    {%- endif %}
  </div>

  {# ── 1. rank the risks ──────────────────────────────────────────────── #}
  <details class="qf-section co-fold" open>
    <summary class="co-macro-head">
      <span class="co-macro-id">1</span>
      <h2>Rank the risks on the card</h2>
      <span class="n">{{ view.rated }} of {{ record.ontology.risks | length }} rated</span>
    </summary>

    {%- if not record.ontology.risks %}
    <div class="error">This AI Card carries no risks, so there is nothing to rank and
       nothing to order the objectives by. Save a card version whose AIRO graph has them, then start its assessment.</div>
    {%- else %}
    <p class="qf-help">Rate each risk 1 (marginal for this system) to 5 (decisive), and say why if
       you like. The objectives answering the worst risks become Tier 1. Unrated risks count as 3.</p>
    {%- if not read_only %}
    <form method="post" action="{{ project_base }}/projects/{{ record.id }}/severity">
    {%- else %}
    <div>
    {%- endif %}
      {%- for risk in risks %}
      <div class="co-risk">
        <div class="co-risk-main">
          <h3>{{ risk.risk.text }}</h3>
          <dl class="qf-dl">
            {%- if risk.risk.source %}<dt>Source</dt><dd>{{ risk.risk.source }}</dd>{% endif %}
            {%- if risk.risk.vulnerability %}<dt>Vulnerability</dt><dd>{{ risk.risk.vulnerability }}</dd>{% endif %}
            {%- if risk.risk.consequence %}<dt>Consequence</dt><dd>{{ risk.risk.consequence }}</dd>{% endif %}
            {%- if risk.risk.control %}<dt>Declared control</dt><dd>{{ risk.risk.control }}</dd>{% endif %}
            {%- if risk.risk.areas %}<dt>Impact</dt><dd>{{ risk.risk.areas | join(', ') }}</dd>{% endif %}
            {%- if risk.risk.stakeholder %}<dt>Borne by</dt><dd>{{ risk.risk.stakeholder }}</dd>{% endif %}
            {%- if risk.risk.vair_terms %}<dt>Typed in VAIR</dt><dd>{{ risk.risk.vair_terms | join(', ') }}</dd>{% endif %}
          </dl>
          {%- if view.mapped %}
          <p class="co-reason">
            {%- if risk.mapped %}Mitigated by
            {%- for objective_id, rationale, source in risk.mapped %}
            <span class="qf-tag qf-tag--in" title="{{ rationale or 'mapped by a person' }}">{{ objective_id }} {{ objective_labels.get(objective_id, '') }}</span>
            {%- endfor %}
            {%- else %}<em>No objective was mapped to this risk.</em>{% endif %}
          </p>
          {%- endif %}
          {%- for finding in risk.findings %}
          <p class="co-note co-note--flag"><b>{{ finding.flag }}:</b> {{ finding.detail }}</p>
          {%- endfor %}
        </div>
        <div class="field">
          <label for="{{ risk.risk.id }}">Severity</label>
          {%- if read_only %}
          <span id="{{ risk.risk.id }}">{{ risk.rating or "unrated" }}</span>
          {%- if risk.comment %}<p class="co-sev-comment">{{ risk.comment }}</p>{% endif %}
          {%- else %}
          <select id="{{ risk.risk.id }}" name="{{ risk.risk.id }}">
            {%- for n in [5, 4, 3, 2, 1] %}
            <option value="{{ n }}" {% if risk.rating == n %}selected{% endif %}>{{ n }}</option>
            {%- endfor %}
          </select>
          <label class="co-sev-label" for="comment-{{ risk.risk.id }}">Why <span>(optional)</span></label>
          <textarea id="comment-{{ risk.risk.id }}" name="comment:{{ risk.risk.id }}" maxlength="1000" rows="3"
                    placeholder="What makes it this severe for this system">{{ risk.comment }}</textarea>
          {%- endif %}
        </div>
      </div>
      {%- endfor %}
      {%- if not read_only %}
      <div class="qf-actions"><button class="btn" type="submit">Save the ranking</button></div>
    </form>
      {%- else %}
    </div>
      {%- endif %}
    {%- endif %}
  </details>

  {# ── 2. map them to objectives ──────────────────────────────────────
     By the AI (the risk mapper, one model call per risk) or by a person, risk
     by risk; a person can also correct what the AI proposed. #}
  {%- if record.ontology.risks %}
  <details class="qf-section co-fold" open>
    <summary class="co-macro-head">
      <span class="co-macro-id">2</span>
      <h2>Map the risks to control objectives</h2>
      <span class="n">{% if view.mapped %}mapped{% else %}not yet mapped{% endif %}</span>
    </summary>

    {%- if view.mapped and record.mapping_run.attempts and record.mapping_run.stop != "clean" %}
    <div class="error">The mapping stopped on <code>{{ record.mapping_run.stop }}</code>{% if record.mapping_run.error %}: {{ record.mapping_run.error }}{% endif %}.
       What survived its checks is above; what did not is listed with each risk.</div>
    {%- endif %}
    <p class="qf-help">Map each risk to the objectives that would mitigate it, by hand below, or with
       the AI. An objective scores the sum of the severities of the risks mapped to it.</p>
    {%- if not read_only %}
    <form class="co-ai" method="post" action="{{ project_base }}/projects/{{ record.id }}/map">
      {%- set ai_ran = record.mapping_run and record.mapping_run.attempts %}
      <button class="btn" type="submit">{% if ai_ran %}Map again with AI{% else %}Map with AI{% endif %}</button>
      <button type="button" class="co-help" popovertarget="ai-help" aria-label="What mapping with AI does">?</button>
      <div id="ai-help" class="co-help-pop" popover>
        <b>Mapping with AI.</b> The AI reads each risk against the catalogue and proposes the
        objectives that would mitigate it, each resting on a quote from that risk's own chain;
        a proposal with no such quote is sent back. It costs one model call per risk, with the
        model chosen in Manage, Keys. It replaces the whole mapping, edits by hand included:
        correct a risk's mapping by hand afterwards.
      </div>
    </form>
    {%- endif %}

    {%- for risk in risks %}
    <div class="co-map" id="map-{{ risk.risk.id }}">
      <div class="co-map-head">
        <span class="co-map-sev" title="Severity">{{ risk.rating }}</span>
        <h3>{{ risk.risk.short_label or risk.risk.text }}</h3>
      </div>
      {%- if risk.comment %}<p class="co-sev-comment">{{ risk.comment }}</p>{% endif %}
      <p class="co-map-list">
        {%- for objective_id, rationale, source in risk.mapped %}
        <span class="co-map-item" title="{{ rationale or '' }}"><b>{{ objective_id }}</b> {{ objective_labels.get(objective_id, '') }}
          <span class="co-map-source co-map-source--{{ source }}">{% if source == 'person' %}by hand{% else %}AI{% endif %}</span></span>
        {%- else %}<em>Not mapped yet.</em>{% endfor %}
      </p>
      {%- if not read_only %}
      {%- set chosen = risk.mapped | map(attribute=0) | list %}
      <details class="co-map-edit">
        <summary>Edit this risk's mapping</summary>
        <form method="post" action="{{ project_base }}/projects/{{ record.id }}/risks/{{ risk.risk.id }}/mapping">
          {%- for macro in macros %}
          <fieldset class="co-map-dim">
            <legend><span class="co-dim co-dim--r{{ macro.id[1:] }}">{{ macro.id }} · {{ macro.title }}</span></legend>
            {%- for objective in macro.objectives %}
            <label class="co-map-pick"><input type="checkbox" name="objective" value="{{ objective.id }}"{% if objective.id in chosen %} checked{% endif %}>
              <b>{{ objective.id }}</b> {{ objective.sub_requirement_label }}</label>
            {%- endfor %}
          </fieldset>
          {%- endfor %}
          <div class="qf-actions"><button class="btn" type="submit">Save this risk's mapping</button></div>
        </form>
      </details>
      {%- endif %}
    </div>
    {%- endfor %}
  </details>
  {%- endif %}

  {# ── 3. the objectives, in tiers ─────────────────────────────────────
     Only once the mapping has run: before that nothing orders the catalogue,
     and an unordered catalogue is what /objectives already is. #}
  {%- if view.mapped %}
  <div class="co-stats">
    <div class="co-stat co-stat--tier1"><div class="v">{{ counts.tier1 }}</div><div class="k">Tier 1 · start here</div></div>
    <div class="co-stat"><div class="v">{{ counts.tier2 }}</div><div class="k">Tier 2 · next</div></div>
    <div class="co-stat"><div class="v">{{ counts.tier3 }}</div><div class="k">Tier 3 · later</div></div>
  </div>

  {#- Which objectives go forward to step 4, where tests and controls are linked
     to them. The mapped ones start ticked; the checkboxes below belong to this form. #}
  <details class="qf-section co-fold" open>
    <summary class="co-macro-head">
      <span class="co-macro-id">3</span>
      <h2>Select the objectives to take forward</h2>
      <span class="n">{{ selected | length }} selected</span>
    </summary>
    <p class="qf-help">{{ selected | length }} of {{ counts.tier1 + counts.tier2 + counts.tier3 }} selected.
       Only the selected objectives reach <b>Collect evidence</b>, where tests and controls are linked to them.
       The mapped ones start ticked.</p>
    {%- if not read_only %}
    <form id="selection" method="post" action="{{ project_base }}/projects/{{ record.id }}/selection">
      <div class="qf-actions"><button class="btn" type="submit">Save selection</button></div>
    </form>
    {%- endif %}
  </details>

  {%- for section in sections %}
  <details class="qf-section co-fold co-tier--{{ section.key }}" open id="tier-{{ section.key }}">
    <summary class="co-macro-head">
      <h2>{{ section.title }}</h2>
      <span class="n">{{ section.subtitle }} · {{ section.objectives | length }}</span>
    </summary>
    {%- for objective, priority in section.objectives %}
    <article class="co-obj">
      <div class="co-obj-head">
        <span class="co-obj-id">{{ objective.id }}</span>
        <h3>{{ objective.sub_requirement_label }}</h3>
        <span class="co-dim co-dim--r{{ objective.macro_id[1:] }}" title="Trustworthiness dimension">{{ objective.macro_id }} · {{ objective.macro_title }}</span>
        <span class="qf-tag qf-tag--tier{{ priority.tier }}">Tier {{ priority.tier }}</span>
        {%- if priority.non_binding %}<span class="qf-tag qf-tag--voluntary">Non-binding</span>{% endif %}
        {%- if read_only %}{% if objective.id in selected %}<span class="qf-tag">Selected</span>{% endif %}
        {%- else %}
        <label class="co-pick"><input type="checkbox" form="selection" name="objective" value="{{ objective.id }}"{% if objective.id in selected %} checked{% endif %}> Take forward</label>
        {%- endif %}
      </div>
      <p class="co-reason co-why">{% if priority.tier == 1 %}<b>Start here.</b> {% endif %}{{ priority.reasons | join('; ') }}.</p>
      <p class="co-text">{{ objective.text }}</p>
      {% include "_objective_meta.html.j2" %}
    </article>
    {%- endfor %}
  </details>
  {%- endfor %}
  {%- endif %}

  <p class="co-count">
    Card <code>{{ record.digest[:12] }}</code> · catalogue <code>{{ record.objectives_digest[:12] }}</code>
    {%- if record.mapping_run and record.mapping_run.attempts %} · AI mapping {{ record.mapping_run.attempts }} attempt{{ 's' if record.mapping_run.attempts != 1 }}, <code>{{ record.mapping_run.stop }}</code>, {{ record.mapping_run.model }}{% endif %}
  </p>
{% endblock %}
