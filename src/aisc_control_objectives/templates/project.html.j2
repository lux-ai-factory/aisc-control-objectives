{% extends "_base.html.j2" %}

{% block title %}{{ view.record.name }} · Control Objectives{% endblock %}

{% block content %}
  {%- set record = view.record %}
  <a class="co-back" href="{{ project_base }}/projects">← Projects</a>

  <div class="co-header">
    <h1>{{ record.name }}</h1>
    <p>{% if record.version_number %}Assessment of v{{ record.version_number }} · {% endif %}{{ record.system_name }}{% if record.qualification_id %} · qualification {{ record.qualification_id }}{% endif %}</p>
  </div>
  {%- if read_only %}
  <div class="error">{{ read_only }}. This assessment is kept as it was: open the latest version's assessment from the projects page to rank and map.</div>
  {%- endif %}

  {# ── the objective profile it runs on ──────────────────────────────────
     Everything below sees only this profile's objectives. #}
  <div class="co-profile">
    <span class="co-profile-k">Objective profile</span>
    <b class="co-profile-name">{{ profile['label'] }}</b>
    {%- if profile['update'] and not read_only %}
    <form method="post" action="{{ project_base }}/projects/{{ record.id }}/profile" class="co-profile-update">
      <input type="hidden" name="profile" value="{{ profile['id'] }}">
      <span>Version {{ profile['update']['to'] }} is out.</span>
      <button class="btn btn--small" type="submit">Take version {{ profile['update']['to'] }}</button>
    </form>
    {%- elif profile['update'] %}<span class="co-profile-note">Version {{ profile['update']['to'] }} is out.</span>
    {%- endif %}
    {%- if not read_only %}
    <details class="co-profile-change">
      <summary>Change profile</summary>
      <form method="post" action="{{ project_base }}/projects/{{ record.id }}/profile">
        <select class="co-select" name="profile" aria-label="Objective profile">
          {%- for p in profiles %}
          <option value="{{ p.id }}"{% if p.id == profile['id'] %} selected{% endif %}>{{ p.name }}{% if p.number %} (version {{ p.number }}){% endif %} · {{ p.objectives }} objectives</option>
          {%- endfor %}
        </select>
        <button class="btn btn--small" type="submit">Use this profile</button>
        <p class="qf-help">Mappings and selected objectives outside the new profile are dropped.
           Profiles are made on the <a href="{{ project_base }}/profiles">Profiles</a> page.</p>
      </form>
    </details>
    {%- endif %}
  </div>

  {%- if not record.ontology.risks %}
  <div class="error">This AI Card carries no risks, so there is nothing to rate and nothing to put in
     the matrix. Save a card version whose AIRO graph has them, then start its assessment.</div>
  {%- else %}

  {# ── 1. the risk register: one row per risk, rated impact x likelihood ── #}
  <details class="qf-section co-fold" open id="register">
    <summary class="co-macro-head">
      <span class="co-macro-id">1</span>
      <h2>Risk register</h2>
      <span class="n">{{ view.fully_rated }} of {{ record.ontology.risks | length }} rated</span>
    </summary>
    <p class="qf-help">Rate each risk's impact and likelihood, 1 to 5. The rating is their product:
       Low 1-4, Medium 5-9, High 10-16, Critical 17-25. An unrated part counts 3.</p>
    {%- if not read_only %}<form id="ratings" method="post" action="{{ project_base }}/projects/{{ record.id }}/severity">{% endif %}
    <table class="co-register">
      <thead><tr><th>Risk</th><th>Impact</th><th>Likelihood</th><th>Rating</th><th>Rationale <span>(optional)</span></th></tr></thead>
      <tbody>
      {%- for risk in risks %}
      <tr id="risk-{{ risk.risk.id }}">
        <td class="co-reg-risk">
          <b>{{ risk.risk.short_label or risk.risk.text }}</b>
          <details class="co-chain">
            <summary>The AIRO chain</summary>
            {%- if risk.risk.short_label %}<p>{{ risk.risk.text }}</p>{% endif %}
            <dl class="qf-dl">
              {%- if risk.risk.source %}<dt>Source</dt><dd>{{ risk.risk.source }}</dd>{% endif %}
              {%- if risk.risk.vulnerability %}<dt>Vulnerability</dt><dd>{{ risk.risk.vulnerability }}</dd>{% endif %}
              {%- if risk.risk.consequence %}<dt>Consequence</dt><dd>{{ risk.risk.consequence }}</dd>{% endif %}
              {%- if risk.risk.control %}<dt>Declared control</dt><dd>{{ risk.risk.control }}</dd>{% endif %}
              {%- if risk.risk.areas %}<dt>Impact on</dt><dd>{{ risk.risk.areas | join(', ') }}</dd>{% endif %}
              {%- if risk.risk.stakeholder %}<dt>Borne by</dt><dd>{{ risk.risk.stakeholder }}</dd>{% endif %}
              {%- if risk.risk.vair_terms %}<dt>Typed in VAIR</dt><dd>{{ risk.risk.vair_terms | join(', ') }}</dd>{% endif %}
            </dl>
          </details>
        </td>
        {%- for part, value in (("impact", risk.impact), ("likelihood", risk.likelihood)) %}
        <td>
          {%- if read_only %}{{ value or "not rated" }}
          {%- else %}
          {#- an unrated part shows 3, what it counts as; saving the ratings stores it -#}
          {%- set shown = 3 if value is none else value %}
          <select class="co-select" name="{{ part }}:{{ risk.risk.id }}" aria-label="{{ part | capitalize }} of {{ risk.risk.short_label or risk.risk.id }}">
            {%- for n in [5, 4, 3, 2, 1] %}<option value="{{ n }}"{% if shown == n %} selected{% endif %}>{{ n }}</option>{% endfor %}
          </select>
          {%- endif %}
        </td>
        {%- endfor %}
        <td><span class="co-rating co-rating--{{ risk.band | lower }}">{{ risk.rating }}</span>
          <span class="co-band">{{ risk.band }}</span></td>
        <td>
          {%- if read_only %}{% if risk.comment %}<p class="co-sev-comment">{{ risk.comment }}</p>{% endif %}
          {%- else %}
          <textarea name="comment:{{ risk.risk.id }}" maxlength="1000" rows="2" aria-label="Rationale"
                    placeholder="Why this rating">{{ risk.comment }}</textarea>
          {%- endif %}
        </td>
      </tr>
      {%- endfor %}
      </tbody>
    </table>
    {%- if not read_only %}
      <div class="qf-actions"><button class="btn" type="submit">Save the ratings</button></div>
    </form>
    {%- endif %}
  </details>

  {# ── 2. the matrix: one row per risk -> objective ───────────────────────
     The mapping is the matrix: what is in it goes forward to step 4. #}
  <details class="qf-section co-fold" open id="matrix">
    <summary class="co-macro-head">
      <span class="co-macro-id">2</span>
      <h2>Risk and control matrix</h2>
      <span class="n">{{ matrix | length }} row{{ 's' if matrix | length != 1 }} · {{ keys | length }} key</span>
    </summary>
    {%- if view.mapped and record.mapping_run.attempts and record.mapping_run.stop != "clean" %}
    <div class="error">The AI's suggestions stopped on <code>{{ record.mapping_run.stop }}</code>{% if record.mapping_run.error %}: {{ record.mapping_run.error }}{% endif %}.
       What survived its checks is below; what did not is listed with each risk.</div>
    {%- endif %}
    <p class="qf-help">Each row is a risk and a control objective that mitigates it. An objective scores
       the sum of the ratings of its risks; the key ones are where to start. What is in the matrix
       goes forward to <b>Collect evidence</b>.</p>
    {%- if not read_only %}
    <form class="co-ai" method="post" action="{{ project_base }}/projects/{{ record.id }}/map">
      <button class="btn" type="submit">Suggest with AI</button>
      <button type="button" class="co-help" popovertarget="ai-help" aria-label="What suggesting with AI does">?</button>
      <div id="ai-help" class="co-help-pop" popover>
        <b>Suggest with AI.</b> The AI reads each risk against the catalogue and proposes the
        objectives that would mitigate it, each resting on a quote from that risk's own chain;
        a proposal with no such quote is sent back. It costs one model call per risk, with the
        model chosen in Manage, Keys. It replaces the whole matrix, the assessor's own rows
        included: correct a risk's rows afterwards.
      </div>
    </form>
    <form id="keys" method="post" action="{{ project_base }}/projects/{{ record.id }}/key"></form>
    {%- endif %}
    <table class="co-matrix">
      <thead><tr><th>Risk</th><th>Rating</th><th>Control objective</th><th>Mapped</th><th>Score</th><th>Key</th></tr></thead>
      <tbody>
      {%- for risk in risks %}
      {%- set rows = matrix | selectattr("risk", "equalto", risk) | list %}
      {%- for row in rows %}
      <tr class="co-mrow{% if loop.first %} co-mrow--first{% endif %}" data-risk="{{ risk.risk.id }}" data-objective="{{ row.objective.id }}">
        <td class="co-m-risk">{% if loop.first %}{{ risk.risk.short_label or risk.risk.text }}{% endif %}</td>
        <td>{% if loop.first %}<span class="co-rating co-rating--{{ risk.band | lower }}">{{ risk.rating }}</span>{% endif %}</td>
        <td class="co-m-obj"><b>{{ row.objective.id }}</b> {{ row.objective.sub_requirement_label }}
          <span class="co-dim co-dim--r{{ row.objective.macro_id[1:] }}">{{ row.objective.macro_id }}</span></td>
        <td><span class="co-map-source co-map-source--{{ row.source }}" title="{{ row.rationale or '' }}">{% if row.source == 'person' %}Assessor{% else %}AI{% endif %}</span></td>
        <td>{{ row.priority.score | int }}</td>
        <td>
          {#- one choice per objective: its ticks in every row move together (static/keys.js) -#}
          {%- if read_only %}{% if row.priority.key %}<span class="qf-tag qf-tag--tier1">Key</span>{% endif %}
          {%- else %}<input type="checkbox" form="keys" name="key" value="{{ row.objective.id }}"{% if row.priority.key %} checked{% endif %} aria-label="{{ row.objective.id }} is key">{% endif %}
        </td>
      </tr>
      {%- else %}
      <tr class="co-mrow co-mrow--empty" data-risk="{{ risk.risk.id }}">
        <td class="co-m-risk">{{ risk.risk.short_label or risk.risk.text }}</td>
        <td><span class="co-rating co-rating--{{ risk.band | lower }}">{{ risk.rating }}</span></td>
        <td colspan="4"><em>No objective yet.</em></td>
      </tr>
      {%- endfor %}
      {%- if risk.findings or not read_only %}
      <tr class="co-medit"><td colspan="6">
        {%- for finding in risk.findings %}
        <p class="co-note co-note--flag"><b>{{ finding.flag }}:</b> {{ finding.detail }}</p>
        {%- endfor %}
        {%- if not read_only %}
        {%- set chosen = risk.mapped | map(attribute=0) | list %}
        <details class="co-map-edit" id="map-{{ risk.risk.id }}">
          <summary>Edit this risk's objectives</summary>
          <form method="post" action="{{ project_base }}/projects/{{ record.id }}/risks/{{ risk.risk.id }}/mapping">
            {%- for macro in macros %}
            <fieldset class="co-map-dim">
              <legend><span class="co-dim co-dim--r{{ macro.id[1:] }}">{{ macro.id }} · {{ macro.title }}</span></legend>
              {%- for objective in macro.objectives %}
              <label class="co-map-pick"><input type="checkbox" name="objective" value="{{ objective.id }}"{% if objective.id in chosen %} checked{% endif %}>
                <b>{{ objective.id }}</b> {{ objective.sub_requirement_label }}</label>
              {%- endfor %}
            </fieldset>
            {%- endfor %}
            <div class="qf-actions"><button class="btn" type="submit">Save this risk's objectives</button></div>
          </form>
        </details>
        {%- endif %}
      </td></tr>
      {%- endif %}
      {%- endfor %}
      </tbody>
    </table>
    {%- if not read_only and matrix %}
    <div class="qf-actions"><button class="btn" type="submit" form="keys">Save the key objectives</button></div>
    <script src="{{ root_path }}/static/keys.js" defer></script>
    {%- endif %}
  </details>
  {%- endif %}

  <p class="co-count">
    Card <code>{{ record.digest[:12] }}</code> · catalogue <code>{{ record.objectives_digest[:12] }}</code>
    {%- if record.mapping_run and record.mapping_run.attempts %} · AI mapping {{ record.mapping_run.attempts }} attempt{{ 's' if record.mapping_run.attempts != 1 }}, <code>{{ record.mapping_run.stop }}</code>, {{ record.mapping_run.model }}{% endif %}
  </p>
{% endblock %}
