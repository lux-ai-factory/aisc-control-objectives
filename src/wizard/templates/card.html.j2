{% extends "_base.html.j2" %}

{% block title %}{{ record.card.system_name }} · Control Objectives{% endblock %}

{% block content %}
  <a class="co-back" href="{{ root_path }}/">← All objectives</a>

  <div class="co-header">
    <h1>{{ record.card.system_name }} <span style="color: var(--muted); font-weight: 700">{{ record.card.system_version }}</span></h1>
    <p>{{ record.card.provider }}{% if record.card.classification.sectors %} · {{ record.card.classification.sectors | join(', ') }}{% endif %}</p>
  </div>

  {%- if record.run.stop == "failed" %}
  <div class="error">The model could not propose a profile ({{ record.run.error }}). Set the three facts below yourself and confirm.</div>
  {%- elif not record.confirmed %}
  <div class="notice">Profile proposed by the model, not yet confirmed. Check each fact against its quote, correct it if needed, then confirm. Until then every verdict below is provisional.</div>
  {%- else %}
  <div class="notice">Profile confirmed. The verdicts below follow from it.</div>
  {%- endif %}

  <div class="qf-section">
    <h2>Applicability profile</h2>
    <p class="qf-help">Three facts decide which objectives bind this system. The model proposed each
       from a literal span of the card; you confirm or override.</p>

    <form method="post" action="{{ root_path }}/cards/{{ record.id }}/profile">
      {%- for name, question in facts %}
      {%- set fact = record.profile.fact(name) %}
      <div class="co-fact">
        <div>
          <h3>{{ question }}</h3>
          {%- if fact.rationale %}<p class="q">{{ fact.rationale }}</p>{% endif %}
          {%- if fact.quote %}
          <blockquote class="co-quote">“{{ fact.quote }}”
            <small>{{ fact.source or "card" }}{% if name == "high_risk" and fact.annex_iii_point %} · Annex III point {{ fact.annex_iii_point }}{% endif %}</small>
          </blockquote>
          {%- elif fact.value == "undetermined" %}
          <p class="q">The card does not settle this.</p>
          {%- endif %}
          {%- for finding in record.run.findings if finding.fact == name %}
          <p class="co-note co-note--flag"><b>{{ finding.flag }}:</b> {{ finding.detail }}</p>
          {%- endfor %}
        </div>
        <div class="field">
          <label for="{{ name }}">Your answer</label>
          <select id="{{ name }}" name="{{ name }}">
            {%- for option in ("yes", "no", "undetermined") %}
            <option value="{{ option }}" {% if fact.value == option %}selected{% endif %}>{{ option }}</option>
            {%- endfor %}
          </select>
        </div>
      </div>
      {%- endfor %}
      <div class="qf-actions"><button class="btn" type="submit">Confirm profile</button></div>
    </form>
  </div>

  <div class="co-stats">
    <div class="co-stat"><div class="v">{{ counts.to_achieve }}</div><div class="k">To achieve</div></div>
    <div class="co-stat"><div class="v">{{ counts.non_binding }}</div><div class="k">Non-binding</div></div>
    <div class="co-stat"><div class="v">{{ counts.not_applicable }}</div><div class="k">Not applicable</div></div>
    <div class="co-stat"><div class="v">{{ counts.pending }}</div><div class="k">Pending</div></div>
  </div>

  {%- for macro in macros %}
  <section class="qf-section" id="{{ macro.id }}">
    <div class="co-macro-head">
      <span class="co-macro-id">{{ macro.id }}</span>
      <h2>{{ macro.title }}</h2>
      <span class="n">{{ macro.in_scope }} of {{ macro.objectives | length }} to achieve</span>
    </div>

    {%- for objective, verdict in macro.objectives %}
    <article class="co-obj {{ 'co-obj--out' if verdict.applies == 'no' else '' }}">
      <div class="co-obj-head">
        <span class="co-obj-id">{{ objective.id }}</span>
        <h3>{{ objective.sub_requirement_label }}</h3>
        {%- if verdict.non_binding %}
        <span class="qf-tag qf-tag--voluntary">Non-binding</span>
        {%- elif verdict.applies == "yes" %}
        <span class="qf-tag qf-tag--in">To achieve{% if verdict.provisional %} · provisional{% endif %}</span>
        {%- elif verdict.applies == "no" %}
        <span class="qf-tag">Not applicable{% if verdict.provisional %} · provisional{% endif %}</span>
        {%- else %}
        <span class="qf-tag qf-tag--pending">Pending</span>
        {%- endif %}
      </div>
      <p class="co-reason">{{ verdict.reason }}</p>
      <p class="co-text">{{ objective.text }}</p>
      {% include "_objective_meta.html.j2" %}
    </article>
    {%- endfor %}
  </section>
  {%- endfor %}

  <p class="co-count">Profile run: {{ record.run.attempts }} attempt{{ 's' if record.run.attempts != 1 }}, stopped <code>{{ record.run.stop }}</code>
     · assessed {{ record.created_at }} · card {{ record.card.qualification_id }}</p>
{% endblock %}
