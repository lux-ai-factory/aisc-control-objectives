<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Assessment Plan — {{ plan.system_name }}</title>
    <style>{{ css }}</style>
</head>
<body>
    <section class="cover">
        <h1>AI Trustworthiness Assessment Plan</h1>
        <div class="system">{{ plan.system_name }}</div>
        <div class="meta">
            <span>Status: {{ plan.status }}</span>
            <span>Created: {{ plan.created_at.strftime("%Y-%m-%d") }}</span>
            <span>Qualification: {{ plan.qualification_id }}</span>
        </div>
    </section>

    {% if dimensions %}
    {% for dim in dimensions %}
    <section class="dimension">
        <div class="dimension-head">
            <h2>{{ dim.label }}</h2>
            <span class="status status-{{ dim.status }}">{{ dim.status }}</span>
        </div>
        {% if dim.relevance_reason %}
        <p class="relevance">{{ dim.relevance_reason }}</p>
        {% endif %}

        {% if dim.already_addressed %}
        <div class="block-label">Already addressed by the system</div>
        <ul>{% for a in dim.already_addressed %}<li>{{ a }}</li>{% endfor %}</ul>
        {% endif %}

        {% if dim.residual_gaps %}
        <div class="block-label">Residual gaps</div>
        <ul>{% for g in dim.residual_gaps %}<li>{{ g }}</li>{% endfor %}</ul>
        {% endif %}

        {% set items = dim.recommended_item_ids | map('lookup_item', items_by_id) | select | list %}
        {% if items %}
        <div class="block-label">Recommended</div>
        {% for item in items %}
        <div class="item">
            <div class="head">
                {{ item.item_id }}
                <span class="priority">{{ item.score }}/5</span>
                <span class="type">({{ item.item_type }})</span>
            </div>
            <div class="rationale">{{ item.rationale }}</div>
        </div>
        {% endfor %}
        {% elif not dim.residual_gaps %}
        <p class="muted">No additional items required — this dimension is already adequately covered.</p>
        {% endif %}
    </section>
    {% endfor %}
    {% else %}
    <p class="muted">No dimensions were assessed for this plan.</p>
    {% endif %}

    {% if plan.gaps %}
    <section class="gaps-summary">
        <h2>Outstanding coverage gaps</h2>
        <ul>{% for g in plan.gaps %}<li>{{ g }}</li>{% endfor %}</ul>
    </section>
    {% endif %}
</body>
</html>
