# Copy to `.env` (git-ignored) and fill in the key for the provider you use.
#
# Which model is set in wizard.toml, or here with BAF's own variables. The
# wizard reaches its model through BAF, the same way the qualification app's
# ontology filler does, so each provider reads its own variable.

# BAF_LLM_PROVIDER=ollama
# BAF_LLM_MODEL=mistral:latest

# A model on this machine needs no key at all (the committed default).
# BAF_LLM_BASE_URL=http://localhost:11434     # ollama, if not the default host

# ...or a hosted provider, each under its own name:
# MISTRAL_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# QWEN_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
# META_API_KEY=

# ...or an endpoint you host that speaks OpenAI chat-completions (vLLM, LM
# Studio, a gateway). Its token is not an OpenAI key, so it has its own name.
# BAF_LLM_PROVIDER=compatible
# BAF_LLM_BASE_URL=http://localhost:8000/v1
# BAF_LLM_API_KEY=

# Optional overrides (otherwise from wizard.toml / defaults):
# WIZARD_CONFIG_FILE=/path/to/wizard.toml
# WIZARD_PORT=8090

# Serve a different control-objectives export instead of the bundled CSV.
# WIZARD_OBJECTIVES_FILE=/path/to/ai_act_control_objectives.csv

# Only plain KEY=VALUE lines are read (an `export ` prefix, quotes and a
# trailing # comment are fine); anything fancier is not parsed.
