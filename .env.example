# Copy to `.env` (git-ignored) and fill in the key for the provider your model
# uses. The model is set in wizard.toml (e.g. "anthropic/claude-opus-4-8" or
# "openai/gpt-4o-mini"); LiteLLM reads the matching key from here.

ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# AZURE_API_KEY=...
# AZURE_API_BASE=https://<resource>.openai.azure.com
# (Bedrock uses the standard AWS_* credentials; Ollama needs no key.)

# Optional overrides (otherwise from wizard.toml / defaults):
# WIZARD_CONFIG_FILE=/path/to/wizard.toml
# WIZARD_CATALOGUE_URL=http://localhost:8001
# WIZARD_PORT=8090
