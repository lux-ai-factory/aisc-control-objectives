# Copy to `.env` (git-ignored) and fill in the key for the provider your model\n# uses. The model is set in wizard.toml (e.g. "anthropic/claude-opus-4-8" or\n# "openai/gpt-4o-mini"); LiteLLM reads the matching key from here.\n\nANTHROPIC_API_KEY=sk-ant-...\n# OPENAI_API_KEY=sk-...\n# GEMINI_API_KEY=...\n# AZURE_API_KEY=...\n# AZURE_API_BASE=https://<resource>.openai.azure.com\n# (Bedrock uses the standard AWS_* credentials; Ollama needs no key.)\n\n# Optional overrides (otherwise from wizard.toml / defaults):\n# WIZARD_CONFIG_FILE=/path/to/wizard.toml\n# WIZARD_PORT=8090\n\n# Serve a different control-objectives export instead of the bundled CSV.\n# WIZARD_OBJECTIVES_FILE=/path/to/ai_act_control_objectives.csv\n\n# Only plain KEY=VALUE lines are read (an `export ` prefix, quotes and a\n# trailing # comment are fine); anything fancier is not parsed.\n