  {
    "@id": "https://lux-ai-factory.github.io/qualification/q/cmtvvrnw50000jzyvas8gmn3u#risk0_control",
    "@type": [
      "https://w3id.org/airo#RiskControl",
      "https://w3id.org/vair#ManualControl"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Officer review of every Reject"
      }
    ],
    "https://lux-ai-factory.github.io/qualification/ns#fullLabel": [
      {
        "@value": "Every Reject and every Review case goes to a trained loan officer before any decision reaches the applicant; bureau coverage below the configured threshold forces the case into Review"
      }
    ],
    "https://lux-ai-factory.github.io/qualification/ns#provenance": [
      {
        "@value": "form"
      }
    ],
    "https://w3id.org/airo#isFollowedByControl": [
      {
        "@id": "https://lux-ai-factory.github.io/qualification/q/cmtvvrnw50000jzyvas8gmn3u#risk0_control_followup"
      }
    ],
