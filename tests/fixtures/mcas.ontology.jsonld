  {
    "@id": "https://lux-ai-factory.github.io/qualification/q/cmtvvrnw50000jzyvas8gmn3u#deployer",
    "@type": [
      "https://w3id.org/airo#AIOperator"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Retail banks in DE, FR and NL"
      }
    ],
    "https://lux-ai-factory.github.io/qualification/ns#fullLabel": [
      {
        "@value": "Retail banks and consumer micro-finance providers licensed in DE, FR and NL, who run MCAS inside their own data centre and inside their own lending workflow. Each deployer configures the Approve/Review/Reject thresholds to its own risk appetite, staffs the Review queue with its own trained loan officers, and remains the controller for applicant data. Creditum AI SARL never operates the system on a deployer's behalf and never sees applicant-level data."
      }
    ],
    "https://lux-ai-factory.github.io/qualification/ns#provenance": [
      {
        "@value": "form"
      }
    ]
  },
